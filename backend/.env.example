# Локальная разработка (по умолчанию)
DATABASE_URL=sqlite+aiosqlite:///./data/autoposter.db
SCHEDULER_MODE=inline
TICK_INTERVAL_SECONDS=30
SECRET_KEY=dev-secret-change-me
PUBLIC_BASE_URL=http://localhost:8000

# Хранилище медиа: local (диск, по умолчанию) или s3 (любой S3-совместимый:
# MinIO, Yandex Object Storage, Selectel, AWS...)
MEDIA_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# если бакет публичный — прямые ссылки вместо presigned:
S3_PUBLIC_BASE=
S3_PUBLIC_STYLE=path

# отдельный мастер-ключ шифрования токенов соцсетей (пусто = производный от SECRET_KEY)
CREDENTIALS_SECRET=

# --- Биллинг: ЮKassa (необязательно; без ключей доступна ручная активация тарифов) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_RETURN_PATH=/settings

# Ключи OAuth-приложений соцсетей (необязательно — можно подключать по токенам)
VK_APP_ID=
VK_APP_SECRET=
OK_APP_ID=
OK_APP_SECRET=
OK_APP_PUBLIC_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
